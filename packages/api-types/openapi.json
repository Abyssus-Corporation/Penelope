{
  "openapi": "3.1.0",
  "info": {
    "title": "Penelope API",
    "description": "Self-hosted deployment platform API",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness probe. Does not touch the database.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Process is live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Placeholder list handler. The deny-by-default auth layer rejects unauthenticated\ncalls with 401; the body is reachable only after real auth lands.",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "description": "Project list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness probe. Succeeds only when the database accepts a query.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Process is ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "JSON error body returned by the API.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GitProvider": {
        "type": "string",
        "enum": [
          "github",
          "gitlab",
          "bitbucket"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LastCommit": {
        "type": "object",
        "required": [
          "id",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "description": "Mirrors the frontend `Project` type. Persistence of services and the\noptional Git repo is left to follow-up work.",
        "required": [
          "id",
          "name",
          "services",
          "deployedAt"
        ],
        "properties": {
          "deployedAt": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repo": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectRepo"
              },
              {
                "type": "null"
              }
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          }
        }
      },
      "ProjectRepo": {
        "type": "object",
        "required": [
          "provider",
          "owner",
          "name"
        ],
        "properties": {
          "lastCommit": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LastCommit"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/GitProvider"
          }
        }
      },
      "ReadyResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        }
      },
      "ServiceStatus": {
        "type": "string",
        "enum": [
          "running",
          "building",
          "failed",
          "sleeping"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "ops",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "projects",
      "description": "Project management"
    }
  ]
}
